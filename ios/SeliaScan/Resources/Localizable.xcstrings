    "The saved folder permission expired. Choose the folder again.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprávnění k uložené složce vypršelo. Vyberte ji znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung für den Ordner ist abgelaufen. Wähle ihn erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de la carpeta guardada caducó. Elige la carpeta de nuevo."
