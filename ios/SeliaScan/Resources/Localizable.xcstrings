    "This adds only a visual signature or stamp. It does not verify identity or document integrity.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se přidá pouze vizuální podpis nebo razítko. Neověřuje totožnost ani neporušenost dokumentu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies fügt nur eine sichtbare Unterschrift oder einen Stempel hinzu. Identität und Dokumentintegrität werden nicht bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo añade una firma o un sello visual. No verifica la identidad ni la integridad del documento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会添加可视签名或印章，不会验证身份或文档完整性。"
          }
        }
      }
    },
