    "Allow FruitySelia to add images to Photos, then try again.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte FruitySelia přidávat obrázky do Fotek a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube FruitySelia, Bilder zu Fotos hinzuzufügen, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que FruitySelia añada imágenes a Fotos y vuelve a intentarlo."
