    "A scan can contain at most 20 pages.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sken může obsahovat nejvýše 20 stránek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Scan darf höchstens 20 Seiten enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un escaneo puede contener como máximo 20 páginas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次扫描最多可包含 20 页。"
          }
        }
      }
    },
    "A scan must contain between 1 and 20 pages.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sken musí obsahovat 1 až 20 stránek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Scan muss 1 bis 20 Seiten enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un escaneo debe contener entre 1 y 20 páginas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描必须包含 1 到 20 页。"
          }
        }
      }
    },
    "A source page is too large to process safely.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdrojová stránka je příliš velká pro bezpečné zpracování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Quellseite ist für die sichere Verarbeitung zu groß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página de origen es demasiado grande para procesarla de forma segura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源页面过大，无法安全处理。"
