# Copy to .env.appstore. This file is ignored. Never commit credentials.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_FILE=/absolute/path/to/AuthKey_KEYID.p8

# Numeric Apple ID created by App Store Connect after the app record exists.
APP_STORE_APP_ID=
APP_IDENTIFIER=com.majkeylab.seliascan
APPLE_TEAM_ID=MTYBUX7QS6

# Required App Review contact field. Use an internationally dialable number.
APP_REVIEW_PHONE=

# Optional release overrides.
MARKETING_VERSION=2.0
BUILD_NUMBER=
